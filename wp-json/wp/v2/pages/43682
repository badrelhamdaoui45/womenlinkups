eadiness<\/h3>\n\n\n\n<p class=\"has-text-align-center has-text-color\" style=\"color:#ffffff\">Help match UWW\/EXP clients with potential employment opportunities. Our Corporate Engagement Specialist will liaise with your HR team to identify and review compatible employment opportunities available to clients and collaborate with the UWW\/EXP program team to help clients in accessing and preparing for these potential opportunities.<\/p>\n\n\n\n<p class=\"has-text-align-center has-text-color\" style=\"color:#ffffff\">Our team will identify prescreened, job ready client candidates who have built critical hard and soft skills through our program &#8211; candidates that have a wealth of intelligence, growth and resiliency to contribute to your organization.<\/p>\n\n\n\n<div class=\"wp-block-getwid-advanced-spacer\" style=\"height:20px\" aria-hidden=\"true\"><\/div>\n\n\n\n<div class=\"wp-block-buttons is-style-button-group-centered is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-text-align-center wp-element-button\" href=\"https:\/\/doc.storydoc.ai\/5DcRV9\">Discover Pathways to Work<\/a><\/div>\n<\/div>\n\n\n\n<div class=\"wp-block-getwid-advanced-spacer\" style=\"height:32px\" aria-hidden=\"true\"><\/div>\n<\/div><\/div><\/div><\/div><\/div>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":45,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"template-gutenberg.php","meta":{"_acf_changed":false,"_kad_post_transparent":"","_kad_post_title":"","_kad_post_layout":"","_kad_post_sidebar_id":"","_kad_post_content_style":"","_kad_post_vertical_padding":"","_kad_post_feature":"","_kad_post_feature_position":"","_kad_post_header":false,"_kad_post_footer":false,"footnotes":""},"class_list":["post-43682","page","type-page","status-publish","hentry"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plu