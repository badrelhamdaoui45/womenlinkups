{"id":43553,"date":"2026-01-05T12:32:51","date_gmt":"2026-01-05T17:32:51","guid":{"rendered":"https:\/\/upwithwomenstg.wpengine.com\/?page_id=43553"},"modified":"2026-09-08T09:53:56","modified_gmt":"2026-09-08T13:53:56","slug":"gifts-of-securities-mutual-funds","status":"publish","type":"page","link":"https:\/\/upwithwomen.org\/gifts-of-securities-mutual-funds\/","title":{"rendered":"Gifts of Securities &amp; Mutual Funds"},"content":{"rendered":"\n<div class=\"wp-block-getwid-section alignfull alignfull getwid-section-content-custom-width\"><div class=\"wp-block-getwid-section__wrapper getwid-padding-top-large getwid-padding-bottom-large getwid-padding-left-medium getwid-padding-right-medium\" style=\"min-height:70vh\"><div class=\"wp-block-getwid-section__inner-wrapper\" style=\"max-width:743px\"><div class=\"wp-block-getwid-section__background-holder\"><div class=\"wp-block-getwid-section__background has-background has-custom-white-background-color\" style=\"background-image:url('https:\/\/upwithwomen.org\/wp-content\/uploads\/2025\/11\/White-banner.png')\"><div class=\"wp-block-getwid-section__background-image-wrapper\"><img decoding=\"async\" class=\"wp-block-getwid-section__background-image\" src=\"https:\/\/upwithwomen.org\/wp-content\/uploads\/2025\/11\/White-banner.png\" alt=\"White banner\"\/><\/div><\/div><div class=\"wp-block-getwid-section__foreground\" style=\"opacity:0.26;background-color:#FFFFFF\"><\/div><\/div><div class=\"wp-block-getwid-section__content\"><div class=\"wp-block-getwid-section__inner-content\">\n<h1 class=\"wp-block-heading has-text-align-center is-style-heading-page-title has-custom-black-color has-text-color\">GIFTS OF SECURITIES<br>&amp; MUTUAL FUNDS<\/h1>\n\n\n\n<p class=\"has-text-align-center is-style-default has-custom-black-color has-text-color has-link-color wp-elements-6295bd07d504946b9c204b56711656d5\">Donating publicly traded securities or mutual funds is one of the most efficient ways to support Up With Women\/ Exponenti&#8217;elles. Through our secure online form, you can give in a way that&#8217;s both financially savvy and deeply impactful\u2014helping women and gender-diverse people move out of poverty and toward sustainable economic security.<\/p>\n\n\n\n<p class=\"has-text-align-center is-style-default has-custom-black-color has-text-color has-link-color wp-elements-69f40b7c5e6caddb9e494c125d1b5d98\">Up With Women\/Exponenti&#8217;elles is a registered Canadian charity.<br><strong>Charitable Registration No.: <\/strong>838059459RR0001<\/p>\n\n\n\n<div class=\"wp-block-button has-custom-width wp-block-button__width-25 aligncenter\"><a class=\"wp-block-button__link has-text-color has-background has-text-align-center wp-element-button\" href=\"https:\/\/www.canadahelps.org\/en\/dn\/58606\" style=\"color:#ffffff;background-color:#000000\" target=\"_blank\" rel=\"noreferrer noopener\">Go to Secure Form<\/a><\/div>\n<\/div><\/div><\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-getwid-section alignfull alignfull getwid-section-content-custom-width\"><div class=\"wp-block-getwid-section__wrapper getwid-padding-top-large getwid-padding-bottom-large getwid-padding-left-medium getwid-padding-right-medium\" style=\"min-height:70vh\"><div class=\"wp-block-getwid-section__inner-wrapper\" style=\"max-width:1200px\"><div class=\"wp-block-getwid-section__background-holder\"><div class=\"wp-block-getwid-section__background has-background has-grey-100-background-color\"><\/div><div class=\"wp-block-getwid-section__foreground\"><\/div><\/div><div class=\"wp-block-getwid-section__content\"><div class=\"wp-block-getwid-section__inner-content\">\n<div class=\"wp-block-getwid-advanced-spacer\" style=\"height:21px\" aria-hidden=\"true\"><\/div>\n\n\n\n<div class=\"wp-block-columns has-grey-100-background-color has-background is-layout-flex wp-container-core-columns-is-layout-9d6595d7 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column has-grey-100-background-color has-background is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-getwid-advanced-spacer\" style=\"height:20px\" aria-hidden=\"true\"><\/div>\n\n\n\n<h2 class=\"wp-block-heading has-text-align-left is-style-default\">AN EFFECTIVE WAY TO GIVE<\/h2>\n\n\n\n<p class=\"has-text-align-left is-style-default has-custom-black-color has-text-color has-link-color wp-elements-1b613772713388969211f5410cde01f6\">When you donate securities or mutual funds, you:<\/p>\n\n\n\n<div class=\"wp-block-getwid-section is-style-default\"><div class=\"wp-block-getwid-section__wrapper\"><div class=\"wp-block-getwid-section__inner-wrapper\"><div class=\"wp-block-getwid-section__background-holder\"><div class=\"wp-block-getwid-section__background has-background has-custom-white-background-color\"><\/div><div class=\"wp-block-getwid-section__foreground\" style=\"background-color:#FAFAFA\"><\/div><\/div><div class=\"wp-block-getwid-section__content\"><div class=\"wp-block-getwid-section__inner-content\">\n<ul class=\"wp-block-list\">\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-0af1889a2369ea7601f5a822d17f821e\"><strong>Eliminate capital gains tax<\/strong> on the appreciated value of your gift<\/li>\n\n\n\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-aee1c3237c6cd13fd3041abcf7292500\">Receive a <strong>charitable receipt<\/strong> for the full <strong>fair market value<\/strong><\/li>\n\n\n\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-408eefd970e14a9287a29d54a1817091\">Stretch your generosity further, directing more resources to <strong>life-changing programs<\/strong><\/li>\n<\/ul>\n<\/div><\/div><\/div><\/div><\/div>\n\n\n\n<h2 class=\"wp-block-heading has-text-align-left is-style-default\">HOW IT WORKS<\/h2>\n\n\n\n<ol class=\"wp-block-list\">\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-62103776219464f4ac64c8b91ad64d03\">Access our <strong><a href=\"https:\/\/www.canadahelps.org\/en\/dn\/58606\">Gifts of Securities &amp; Mutual Funds form<\/a>.<\/strong><\/li>\n\n\n\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-bb007bc3d9b2f8b8fe2663002b97be1e\">Complete the online form<strong> <\/strong>with details of the securities or mutual funds you wish to donate.<\/li>\n\n\n\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-79981b465f4998989f20a3fbfcf2f5a0\"><strong>CanadaHelps <\/strong>coordinates the <strong>transfer <\/strong>with your financial institution.<\/li>\n\n\n\n<li class=\"has-custom-black-color has-text-color has-link-color wp-elements-ceb6a32f813ba93b12d0e89ae3e3ea59\">Once received, CanadaHelps issues your <strong>official tax receipt<\/strong>, and we&#8217;ll be in touch to share our gratitude and the impact of your gift.<\/li>\n<\/ol>\n\n\n\n<div class=\"wp-block-getwid-advanced-spacer\" style=\"height:36px\" aria-hidden=\"true\"><\/div>\n\n\n\n<h2 class=\"wp-block-heading has-text-align-left is-style-heading-underline\">QUESTIONS?<\/h2>\n\n\n\n<p class=\"has-text-align-left is-style-default has-custom-black-color has-text-color has-link-color wp-elements-47fd135b0c1cb7663f61965dfee96bc1\">We&#8217;re always happy to help, whether you&#8217;re exploring your options or ready to proceed.<br>Contact us at <strong>give@upwithwomen.org<\/strong>. <br><br>All inquiries are handled with care and confidentiality. <\/p>\n<\/div>\n<\/div>\n\n\n\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"\/>\n<\/div><\/div><\/div><\/div><\/div>\n\n\n\n<div class=\"wp-block-getwid-section alignfull alignfull getwid-section-content-custom-width\"><div class=\"wp-block-getwid-section__wrapper getwid-padding-left-medium getwid-padding-right-medium\"><div class=\"wp-block-getwid-section__inner-wrapper\" style=\"max-width:740px\"><div class=\"wp-block-getwid-section__background-holder\"><div class=\"wp-block-getwid-section__background\"><\/div><div class=\"wp-block-getwid-section__foreground\"><\/div><\/div><div class=\"wp-block-getwid-section__content\"><div class=\"wp-block-getwid-section__inner-content\">\n<div class=\"wp-block-columns has-3-columns is-layout-flex wp-container-core-columns-is-layout-9d6595d7 wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\"><\/div>\n<\/div>\n<\/div><\/div><\/div><\/div><\/div>\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":45,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"template-gutenberg.php","meta":{"_acf_changed":false,"_kad_post_transparent":"","_kad_post_title":"","_kad_post_layout":"","_kad_post_sidebar_id":"","_kad_post_content_style":"","_kad_post_vertical_padding":"","_kad_post_feature":"","_kad_post_feature_position":"","_kad_post_header":false,"_kad_post_footer":false,"footnotes":""},"class_list":["post-43553","page","type-page","status-publish","hentry"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v21.2 (Yoast SEO v27.5) - https:\/\/yoast.com\/product\/yoast-seo-premium-wordpress\/ -->\n<title>Gifts of Securities &amp; Mutual Funds - Up With Women<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/upwithwomen.org\/gifts-of-securities-mutual-funds\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Gifts of Securities &amp; Mutual Funds\" \/>\n<meta property=\"og:url\" content=\"https:\/\/upwithwomen.org\/gifts-of-securities-mutual-funds\/\" \/>\n<meta property=\"og:site_name\" content=\"Up With Women\" \/>\n<meta property=\"article:publisher\" content=\"https:\/\/www.facebook.com\/UpWithWomen.Org\/\" \/>\n<meta property=\"article:modified_time\" content=\"2026-09-08T13:53:56+00:00\